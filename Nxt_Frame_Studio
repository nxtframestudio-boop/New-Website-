      <article class="card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="3"/><path d="M10 9.5v5l4.5-2.5z"/></svg>
        </div>
        <h3>Content Creators</h3>
        <p>YouTube videos, Shorts, Reels and TikToks — retention-focused cuts with hooks, captions and sound design.</p>
        <div class="tags"><span class="tag">YouTube</span><span class="tag">Shorts</span><span class="tag">Retention</span></div>
      </article>

      <!-- 3. Podcasts -->
      <article class="card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24"><rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0"/><path d="M12 17.5V21M9 21h6"/></svg>
        </div>
        <h3>Podcasts</h3>
        <p>Multicam switching, audio cleanup, dynamic captions and clip repurposing for every social platform.</p>
        <div class="tags"><span class="tag">Multicam</span><span class="tag">Clips</span><span class="tag">Audio</span></div>
      </article>

      <!-- 4. Ads -->
      <article class="card">
        <div class="card-icon">
