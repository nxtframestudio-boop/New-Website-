</header>

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="wrap hero-inner">
    <span class="pill"><span class="dot"></span> Accepting new projects</span>
    <h1>Video editing that makes<br><span class="grad">every frame count.</span></h1>
    <p class="lede">
