      <!-- 7. Long Videos -->
      <article class="card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="M7.5 4.5v15M16.5 4.5v15M2.5 9.5h5M16.5 9.5h5M2.5 14.5h5M16.5 14.5h5"/></svg>
        </div>
