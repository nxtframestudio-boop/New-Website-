</section>

<!-- ================= PROCESS ================= -->
<section id="process" class="process">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">How It Works</span>
      <h2>A simple, fast workflow</h2>
      <p>No back-and-forth chaos. Just send your footage and get back content that's ready to publish.</p>
    </div>
    <div class="steps">
      <div class="step">
        <span class="step-num">STEP 01</span>
        <h4>Send Footage</h4>
        <p>Upload raw files via Drive, Dropbox or Frame.io with your brief and references.</p>
      </div>
      <div class="step">
        <span class="step-num">STEP 02</span>
        <h4>We Edit</h4>
        <p>Your dedicated editor cuts, colours, sound-designs and adds motion graphics.</p>
      </div>
      <div class="step">
        <span class="step-num">STEP 03</span>
        <h4>Review</h4>
        <p>Get a first draft with timestamped comments. Unlimited revisions until it's right.</p>
      </div>
      <div class="step">
