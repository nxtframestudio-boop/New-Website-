    <div class="hero-prompt">
      <span class="prompt-icon">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2.5"/><path d="M8 20h8M12 18v2"/><path d="M10 9.5v5l4.5-2.5z"/></svg>
      </span>
      <span class="prompt-text">Describe your project — "Edit my real estate tour into 3 reels"</span>
      <span class="prompt-send">
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </div>
  </div>
</section>

<!-- ================= CATEGORIES ================= -->
<section id="services">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">What We Edit</span>
      <h2>Built for every kind of content</h2>
      <p>Seven specialised editing verticals, one dedicated team. Pick your lane — or mix and match.</p>
    </div>

    <div class="grid">

      <!-- 1. Real Estate -->
      <article class="card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.6V21h14V9.6"/><path d="M9.5 21v-6h5v6"/></svg>
        </div>
        <h3>Real Estate</h3>
        <p>Property walkthroughs, listing reels, drone edits and agent branding videos that make buyers stop scrolling.</p>
